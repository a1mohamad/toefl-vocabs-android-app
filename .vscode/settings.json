{
  // Gradle build files are Kotlin *script* (.kts), which is a different file
  // extension from .kt and is not claimed by the Kotlin extension. Without this
  // VS Code opens them as Plain Text — the status bar bottom-right is where you
  // can confirm it.
  "files.associations": {
    "*.kts": "kotlin",
    "*.gradle.kts": "kotlin"
  },

  // Colour comes from two independent places and it helps to know which is
  // which when one of them is missing:
  //
  //   1. A TextMate grammar — instant, offline, purely pattern-based. This is
  //      what colours keywords, strings and comments the moment a file opens.
  //   2. LSP semantic tokens — the JetBrains extension. Slower and smarter: it
  //      knows a name is a *parameter* rather than just a word, so it can tint
  //      it differently. It only starts working once the Gradle project has
  //      been imported successfully.
  //
  // Turning semantic highlighting on explicitly, so the second layer is used
  // once the language server is ready.
  "editor.semanticHighlighting.enabled": true,

  // The Kotlin language server is a JVM process and will not start without
  // this. Point it at the same JDK 17 the build uses. Adjust the path if yours
  // is installed elsewhere.
  // "kotlin.java.home": "C:\\Program Files\\Eclipse Adoptium\\jdk-17",

  "[kotlin]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [100]
  },

  "files.exclude": {
    "**/.gradle": true,
    "**/build": true,
    "**/.kotlin": true
  },

  "search.exclude": {
    "**/build": true,
    "**/.gradle": true
  }
}
